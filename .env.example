# mcp-figma — environment variables
#
# HOW THESE ARE LOADED. This server reads os.environ directly and does NOT load
# a .env file — there is no python-dotenv dependency and no load_dotenv() call
# in the repo. An MCP server receives its environment from the MCP client, so
# these belong in the client config: for Claude Code, ~/.claude/settings.json
# under mcpServers -> figma-api -> env. Copying this file to .env has no effect.
#
# Authoritative reference: README.md "Environment Variables".

# FIGMA_ACCESS_TOKEN — required. Figma Personal Access Token, sent as the
# X-Figma-Token header on every request. Generate it in Figma under
# Settings > Account > Personal access tokens.
FIGMA_ACCESS_TOKEN=your_value_here

# FIGMA_TEAM_ID — optional. Team ID for team-level queries; also reported by
# figma_health_check. Read by server.py. Documented in README.md's table but
# was missing from this file.
FIGMA_TEAM_ID=your_value_here

# FIGMA_FILE_KEY — NOT IMPLEMENTED. Read by nothing. This file previously
# described it as an optional default file key that could "be passed per-call".
# The per-call half is true — every tool takes the file key as a parameter —
# but there is no default: no code reads this variable. Kept commented rather
# than deleted so the intent stays visible.
# FIGMA_FILE_KEY=your_value_here
#
# Not listed here on purpose: FIGMA_WEBHOOK_SECRET, FIGMA_TEST_FILE_KEY and
# FIGMA_SKIP_RAPID_TEST appear only under tests/. Test-only variables do not
# belong in a setup example — listing them implies a runtime knob that is not
# one.
