{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["es2017"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "typeRoots": ["./node_modules/@figma", "./node_modules/@types"],
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
